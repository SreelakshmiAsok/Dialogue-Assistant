  <rdf:type rdf:resource="#TeacherContext"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ParentContextInd">
  <rdf:type rdf:resource="#ParentContext"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PeerContextInd">
  <rdf:type rdf:resource="#PeerContext"/>
</owl:NamedIndividual>

