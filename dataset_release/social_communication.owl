  <rdf:type rdf:resource="#StrangerContext"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MealContextInd">
  <rdf:type rdf:resource="#MealContext"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#TeacherRoleInd">
  <rdf:type rdf:resource="#Teacher"/>
</owl:NamedIndividual>

