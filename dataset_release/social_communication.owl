<owl:Class rdf:about="#TeacherPoliteUtterance">
  <rdfs:subClassOf rdf:resource="#Utterance"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Utterance"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#usesFeature"/>
          <owl:someValuesFrom rdf:resource="#HonorifcMarker"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#usesFeature"/>
          <owl:someValuesFrom rdf:resource="#PurposeStatement"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Utterance"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#usesFeature"/>
          <owl:someValuesFrom rdf:resource="#HonorificMarker"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#HonorificMarker">
  <rdfs:subClassOf rdf:resource="#LinguisticFeature"/>
</owl:Class>

<owl:Class rdf:about="#StrangerSafetyUtterance">
