<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/dialogue-assistant/social-communication"
         xmlns="http://www.semanticweb.org/dialogue-assistant/social-communication#">

<owl:Ontology rdf:about="http://www.semanticweb.org/dialogue-assistant/social-communication">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semantic Dialogue Assistant Ontology for ASD Social Communication Training</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#hasRole">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#SocialRole"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a person to their social role (e.g., Teacher, Parent, Peer)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inContext">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Context"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a person to their current physical/social context</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#speakingTo">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Person"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identifies the interlocutor the user is interacting with</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#recommendsResponse">
  <rdfs:domain rdf:resource="#Utterance"/>
  <rdfs:range rdf:resource="#Response"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links an input utterance to an inferred safe, appropriate response</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasIntent">
  <rdfs:domain rdf:resource="#Utterance"/>
  <rdfs:range rdf:resource="#CommunicativeIntent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usesFeature">
  <rdfs:domain rdf:resource="#Utterance"/>
  <rdfs:range rdf:resource="#LinguisticFeature"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#appropriateFor">
  <rdfs:domain rdf:resource="#CommunicativeIntent"/>
  <rdfs:range rdf:resource="#SocialContext"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#violates">
  <rdfs:domain rdf:resource="#CommunicativeIntent"/>
  <rdfs:range rdf:resource="#SocialContext"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSocialRole">
  <rdfs:domain rdf:resource="#CommunicationScenario"/>
  <rdfs:range rdf:resource="#SocialRole"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inSocialContext">
  <rdfs:domain rdf:resource="#CommunicationScenario"/>
  <rdfs:range rdf:resource="#SocialContext"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#expectsIntent">
  <rdfs:domain rdf:resource="#CommunicationScenario"/>
  <rdfs:range rdf:resource="#CommunicativeIntent"/>
  <owl:propertyDisjointWith rdf:resource="#violatesScenario"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#violatesScenario">
  <rdfs:domain rdf:resource="#CommunicationScenario"/>
  <rdfs:range rdf:resource="#CommunicativeIntent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#allowsAlternativeIntent">
  <rdfs:domain rdf:resource="#CommunicationScenario"/>
  <rdfs:range rdf:resource="#CommunicativeIntent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requiresFeature">
  <rdfs:domain rdf:resource="#CommunicationScenario"/>
  <rdfs:range rdf:resource="#LinguisticFeature"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasText">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Utterance"/>
        <rdf:Description rdf:about="#Response"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#isSafe">
  <rdfs:domain rdf:resource="#Response"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#politenessLevel">
  <rdfs:domain rdf:resource="#Response"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

