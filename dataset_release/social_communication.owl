<owl:Class rdf:about="#SafetyCriticalScenario">
  <rdfs:subClassOf rdf:resource="#CommunicationScenario"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#CommunicationScenario"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#expectsIntent"/>
          <owl:someValuesFrom rdf:resource="#SafetyRefusal"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#TaskCompletionScenario">
  <rdfs:subClassOf rdf:resource="#CommunicationScenario"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#CommunicationScenario"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#expectsIntent"/>
          <owl:someValuesFrom rdf:resource="#TaskCompletionConfirmation"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#PoliteInterruptionScenario">
  <rdfs:subClassOf rdf:resource="#CommunicationScenario"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#CommunicationScenario"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#expectsIntent"/>
          <owl:someValuesFrom rdf:resource="#PoliteInterruption"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#AuthorityDecorumScenario">
  <rdfs:subClassOf rdf:resource="#CommunicationScenario"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#CommunicationScenario"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#requiresFeature"/>
          <owl:someValuesFrom rdf:resource="#HonorificMarker"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#PeerCooperationScenario">
  <rdfs:subClassOf rdf:resource="#CommunicationScenario"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#CommunicationScenario"/>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <owl:Restriction>
              <owl:onProperty rdf:resource="#expectsIntent"/>
              <owl:someValuesFrom rdf:resource="#PeerInvitationAcceptance"/>
            </owl:Restriction>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#expectsIntent"/>
              <owl:someValuesFrom rdf:resource="#CooperativeSuggestion"/>
            </owl:Restriction>
          </owl:unionOf>
        </owl:Class>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:NamedIndividual rdf:about="#ChildUser">
