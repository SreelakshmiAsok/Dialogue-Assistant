  <rdf:type rdf:resource="#Parent"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PeerRoleInd">
  <rdf:type rdf:resource="#Peer"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#StrangerRoleInd">
  <rdf:type rdf:resource="#Stranger"/>
</owl:NamedIndividual>

