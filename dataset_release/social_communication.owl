  <rdf:type rdf:resource="#AnswerQuestion"/>
  <appropriateFor rdf:resource="#ParentContextInd"/>
  <appropriateFor rdf:resource="#MealContextInd"/>
  <appropriateFor rdf:resource="#TeacherContextInd"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#intent_TaskCompletion">
  <rdf:type rdf:resource="#TaskCompletionConfirmation"/>
  <appropriateFor rdf:resource="#ParentContextInd"/>
  <appropriateFor rdf:resource="#TeacherContextInd"/>
