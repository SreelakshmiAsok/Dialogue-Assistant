# ---- MongoDB (accounts, answers/progress, history, roadmap) ----
# Copy this file to `.env` (same folder, never commit it) and fill in your connection string.
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/
# Leave empty to keep using the local JSON files (users.json, datasets/*.json).
MONGO_URI=

# ---- Login tokens ----
# Any long random string. Change it for a real deployment (the built-in default is NOT secure).
JWT_SECRET=
