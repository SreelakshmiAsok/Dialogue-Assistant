<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/dialogue-assistant/social-communication"
         xmlns="http://www.semanticweb.org/dialogue-assistant/social-communication#">

<owl:Ontology rdf:about="http://www.semanticweb.org/dialogue-assistant/social-communication">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Semantic Dialogue Assistant Ontology for ASD Social Communication Training</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#hasRole">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#SocialRole"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a person to their social role (e.g., Teacher, Parent, Peer)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inContext">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Context"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a person to their current physical/social context</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#speakingTo">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="#Person"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identifies the interlocutor the user is interacting with</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#recommendsResponse">
  <rdfs:domain rdf:resource="#Utterance"/>
  <rdfs:range rdf:resource="#Response"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links an input utterance to an inferred safe, appropriate response</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasIntent">
  <rdfs:domain rdf:resource="#Utterance"/>
  <rdfs:range rdf:resource="#CommunicativeIntent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usesFeature">
  <rdfs:domain rdf:resource="#Utterance"/>
  <rdfs:range rdf:resource="#LinguisticFeature"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#appropriateFor">
  <rdfs:domain rdf:resource="#CommunicativeIntent"/>
  <rdfs:range rdf:resource="#SocialContext"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#violates">
  <rdfs:domain rdf:resource="#CommunicativeIntent"/>
  <rdfs:range rdf:resource="#SocialContext"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasText">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Utterance"/>
        <rdf:Description rdf:about="#Response"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#isSafe">
  <rdfs:domain rdf:resource="#Response"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#politenessLevel">
  <rdfs:domain rdf:resource="#Response"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Person"/>

<owl:Class rdf:about="#SocialRole"/>

<owl:Class rdf:about="#Context"/>

<owl:Class rdf:about="#Utterance"/>

<owl:Class rdf:about="#Response"/>

<owl:Class rdf:about="#Teacher">
  <rdfs:subClassOf rdf:resource="#SocialRole"/>
</owl:Class>

<owl:Class rdf:about="#Parent">
  <rdfs:subClassOf rdf:resource="#SocialRole"/>
</owl:Class>

<owl:Class rdf:about="#Peer">
  <rdfs:subClassOf rdf:resource="#SocialRole"/>
</owl:Class>

<owl:Class rdf:about="#Stranger">
  <rdfs:subClassOf rdf:resource="#SocialRole"/>
</owl:Class>

<owl:Class rdf:about="#Classroom">
  <rdfs:subClassOf rdf:resource="#Context"/>
</owl:Class>

<owl:Class rdf:about="#Home">
  <rdfs:subClassOf rdf:resource="#Context"/>
</owl:Class>

<owl:Class rdf:about="#Playground">
  <rdfs:subClassOf rdf:resource="#Context"/>
</owl:Class>

<owl:Class rdf:about="#Greeting">
  <rdfs:subClassOf rdf:resource="#Utterance"/>
</owl:Class>

<owl:Class rdf:about="#Question">
  <rdfs:subClassOf rdf:resource="#Utterance"/>
</owl:Class>

<owl:Class rdf:about="#Request">
  <rdfs:subClassOf rdf:resource="#Utterance"/>
</owl:Class>

<owl:Class rdf:about="#SocialContext">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#CommunicativeIntent">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#LinguisticFeature">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#TeacherContext">
  <rdfs:subClassOf rdf:resource="#SocialContext"/>
</owl:Class>

<owl:Class rdf:about="#PeerContext">
  <rdfs:subClassOf rdf:resource="#SocialContext"/>
</owl:Class>

<owl:Class rdf:about="#StrangerContext">
  <rdfs:subClassOf rdf:resource="#SocialContext"/>
</owl:Class>

<owl:Class rdf:about="#ParentContext">
  <rdfs:subClassOf rdf:resource="#SocialContext"/>
</owl:Class>

<owl:Class rdf:about="#PoliteRequest">
  <rdfs:subClassOf rdf:resource="#CommunicativeIntent"/>
</owl:Class>

<owl:Class rdf:about="#SafetyRefusal">
  <rdfs:subClassOf rdf:resource="#CommunicativeIntent"/>
</owl:Class>

<owl:Class rdf:about="#HonestApology">
  <rdfs:subClassOf rdf:resource="#CommunicativeIntent"/>
</owl:Class>

<owl:Class rdf:about="#CooperativeSuggestion">
  <rdfs:subClassOf rdf:resource="#CommunicativeIntent"/>
</owl:Class>

<owl:Class rdf:about="#HonorifcMarker">
  <rdfs:subClassOf rdf:resource="#LinguisticFeature"/>
</owl:Class>

<owl:Class rdf:about="#SlangMarker">
  <rdfs:subClassOf rdf:resource="#LinguisticFeature"/>
</owl:Class>

<owl:Class rdf:about="#PurposeStatement">
  <rdfs:subClassOf rdf:resource="#LinguisticFeature"/>
</owl:Class>

<owl:Class rdf:about="#RefusalMarker">
  <rdfs:subClassOf rdf:resource="#LinguisticFeature"/>
</owl:Class>

<owl:Class rdf:about="#TrustedAdultReference">
  <rdfs:subClassOf rdf:resource="#LinguisticFeature"/>
</owl:Class>

<owl:Class rdf:about="#ApologyMarker">
  <rdfs:subClassOf rdf:resource="#LinguisticFeature"/>
</owl:Class>

<owl:Class rdf:about="#TeacherPoliteUtterance">
  <rdfs:subClassOf rdf:resource="#Utterance"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Utterance"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#usesFeature"/>
          <owl:someValuesFrom rdf:resource="#HonorifcMarker"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#usesFeature"/>
          <owl:someValuesFrom rdf:resource="#PurposeStatement"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#StrangerSafetyUtterance">
  <rdfs:subClassOf rdf:resource="#Utterance"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Utterance"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#usesFeature"/>
          <owl:someValuesFrom rdf:resource="#RefusalMarker"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#usesFeature"/>
          <owl:someValuesFrom rdf:resource="#TrustedAdultReference"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:NamedIndividual rdf:about="#ChildUser">
  <rdf:type rdf:resource="#Person"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#TeacherRole1">
  <rdf:type rdf:resource="#Teacher"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ClassroomEnv">
  <rdf:type rdf:resource="#Classroom"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SampleGreetingUtterance">
  <rdf:type rdf:resource="#Greeting"/>
  <hasText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Good morning</hasText>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#PoliteTeacherResponse">
  <rdf:type rdf:resource="#Response"/>
  <hasText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Good morning, Teacher! How are you today?</hasText>
  <isSafe rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</isSafe>
  <politenessLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</politenessLevel>
</owl:NamedIndividual>


</rdf:RDF>
